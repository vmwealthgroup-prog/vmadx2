# Copy to .env and fill in. NEVER commit .env.

# ---- Kotak Neo (from Neo app -> Trade API / Invest -> API dashboard) ----
KOTAK_ENVIRONMENT=prod
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=+91XXXXXXXXXX
KOTAK_UCC=
KOTAK_MPIN=
# Optional: TOTP secret (base32) so the bot can generate TOTP itself.
# Leave blank to type the 6-digit TOTP in the dashboard instead.
KOTAK_TOTP_SECRET=

# ---- Safety ----
# Live orders are possible only if ALLOW_LIVE=true AND you click "Enable Live" after login.
ALLOW_LIVE=false

# ---- Dashboard ----
HOST=127.0.0.1
PORT=8000
